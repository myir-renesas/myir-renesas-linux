/*
 * Set DISPLAY_RGB to below values to select using of:
 * - 1: Display-rgb
 * - 0: CON
 *  When the display is turned on, SCI4, SCI1, TF cannot be used because of the PIN reuse function.
 */
#define		SEL_DISPLAY_RGB                         0

/*
 * Set SEL_ETH_CON to below values to select using of:
 * - 1: ETH
 * - 0: CON
 */
#define		SEL_ETH_CON			1

#include "myb-yt2hx-base.dts"

/ {
	model = "MYIR2 Renesas Development EVK based on r9a09g077m44";
	compatible = "renesas,r9a09g077m44-dev", "renesas,r9a09g077m44", "renesas,r9a09g077";

	aliases {
		serial0 = &sci0;
		serial1 = &sci1;
		serial3 = &sci3;
		serial4 = &sci4;
		mmc0 = &sdhi0;
		mmc1 = &sdhi1;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		ethernet0 = &gmac1;
		ethernet1 = &gmac2;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		global_cma: linux,cma@E0000000 {
			compatible = "shared-dma-pool";
			linux,cma-default;
			reusable;
			reg = <0x0 0xD0000000 0x0 0x10000000>;
		};
	};

#if (SEL_DISPLAY_RGB)
	panel@0 {
			compatible = "myirtft_panel_7inch";
			power-supply = <&reg_3p3v>;
			enable-gpios = <&pinctrl RZT2H_GPIO(11, 7) GPIO_ACTIVE_HIGH>;// backlight
			status = "okay";
			no-hpd;

			port {
					panel_lcd_in: endpoint {
							remote-endpoint = <&du_out_rgb>;
					};
			};
	};
#endif

    leds {
		compatible = "gpio-leds";
		// led0 {
		// 		gpios = <&pinctrl RZT2H_GPIO(21, 6) GPIO_ACTIVE_LOW>;
		// 		label = "Blue";
		// 		default-state = "on";
		// 		linux,default-trigger = "heartbeat";
		// };
		// led1 {
		// 		gpios = <&pinctrl RZT2H_GPIO(26, 3) GPIO_ACTIVE_LOW>;
		// 		label = "Green";
		// 		default-state = "on";
		// 		linux,default-trigger = "heartbeat";
		// };

		led2 {
				gpios = <&pinctrl RZT2H_GPIO(32, 2) GPIO_ACTIVE_HIGH>;
				label = "display_con";
			#if (SEL_DISPLAY_RGB)
				default-state = "off";
			#else
				default-state = "on";
			#endif
		};

		led3 {
				gpios = <&pinctrl RZT2H_GPIO(32, 3) GPIO_ACTIVE_HIGH>;
				label = "eth_con";
			#if (SEL_ETH_CON)
				default-state = "off";
			#else
				default-state = "on";
			#endif
		};

		led4 {
				gpios = <&pinctrl RZT2H_GPIO(34, 7) GPIO_ACTIVE_HIGH>;
				label = "eth0";
				default-state = "off";
		};

    };

};

&du {
#if (SEL_DISPLAY_RGB)
	pinctrl-0 = <&du_pins>;
	pinctrl-names = "default";
	status = "okay";

	ports {
		port@0 {
				du_out_rgb: endpoint {
						remote-endpoint = <&panel_lcd_in>;
				};
		};
    };
#else
    status = "disabled";
#endif
};

&i2c2 {
	status = "okay";

	ft5x06: ft5x06@38 {
			compatible = "edt,edt-ft5406", "edt,edt-ft5x06";
			reg = <0x38>;
			// interrupt-parent = <&pinctrl>;
			// interrupts = <RZT2H_GPIO(5, 4) IRQ_TYPE_EDGE_FALLING>;
			reset-gpios = <&pinctrl RZT2H_GPIO(2, 4) GPIO_ACTIVE_HIGH>;
			touchscreen-size-x=<800>;
			touchscreen-size-y=<480>;
	};
};