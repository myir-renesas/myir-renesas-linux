/*
 * Set DISPLAY_RGB to below values to select using of:
 * - 1: Display-rgb
 * - 0: CON
 *  When the display is turned on, SCI4, SCI1, TF cannot be used because of the PIN reuse function.
 */
#define		SEL_DISPLAY_RGB                         1





#include "myb-yt2hx-base.dts"

/ {
	model = "Renesas Development EVK based on r9a09g077m44";
	compatible = "renesas,r9a09g077m44-dev", "renesas,r9a09g077m44", "renesas,r9a09g077";

	aliases {
		serial0 = &sci0;
		serial1 = &sci1;
		serial3 = &sci3;
		serial4 = &sci4;
		mmc0 = &sdhi0;
		mmc1 = &sdhi1;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		ethernet0 = &gmac1;
		ethernet1 = &gmac2;
	};


	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		global_cma: linux,cma@E0000000 {
			compatible = "shared-dma-pool";
			linux,cma-default;
			reusable;
			reg = <0x0 0xD0000000 0x0 0x10000000>;
		};
	};

	panel@0 {
			compatible = "myirtft_panel_7inch";
			power-supply = <&reg_3p3v>;
			enable-gpios = <&pinctrl RZT2H_GPIO(11, 7) GPIO_ACTIVE_HIGH>;// backlight
			status = "okay";
			no-hpd;

			port {
					panel_lcd_in: endpoint {
							remote-endpoint = <&du_out_rgb>;
					};
			};
	};

#if (!SEL_DISPLAY_RGB)
    switch_display: regulator-switch_display {
            compatible = "regulator-fixed";
            regulator-name = "switch_display";
            regulator-min-microvolt = <3300000>;
            regulator-max-microvolt = <3300000>;
            gpios = <&pinctrl RZT2H_GPIO(32, 2) GPIO_ACTIVE_HIGH>;
            enable-active-high;
            regulator-boot-on;
            regulator-always-on;
    };
#endif

};

&du {
	pinctrl-0 = <&du_pins>;
	pinctrl-names = "default";
	status = "okay";

	ports {
		port@0 {
				du_out_rgb: endpoint {
						remote-endpoint = <&panel_lcd_in>;
				};
		};
    };
};
